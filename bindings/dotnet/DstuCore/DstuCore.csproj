<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>DstuCore</RootNamespace>
    <AssemblyName>DstuCore</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Pre-1.0, provisional (T-112) - not published, see docs/DECISIONS.md for the binding's own
         status. Package metadata kept minimal on purpose: no registry publish until T-164 is
         explicitly authorized (docs/bindings-strategy.md's per-binding checklist). -->
    <Version>0.1.0</Version>
    <Authors>cipher_ua</Authors>
    <Description>P/Invoke .NET binding for dstu-core (Ukrainian DSTU cryptographic standards) - provisional, not yet published to NuGet.</Description>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
    <WarningsAsErrors>Nullable</WarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- CS1591 (missing XML doc comment) would otherwise fire on every trivial Stream override
         (CanRead, Seek, etc.) and IDisposable.Dispose() - real public API surface (DstuConstants,
         the crypto_* wrapper methods) already carries doc comments; this only silences the
         boilerplate, not a blanket opt-out. -->
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <!-- Step 4 (docs/bindings-strategy.md's per-binding checklist, D-116): packages this build
       machine's own native library under runtimes/{rid}/native/ - same split T-158's own step 4
       took (D-149) - local RID only; cross-OS runtimes are a release.yml/CI job, not built here.
       RID detection is deliberately simple (three mutually exclusive OS checks), not a full
       runtime-graph match, since this package only ever carries the one native asset the machine
       running `dotnet pack` actually built. -->
  <PropertyGroup>
    <DstuCoreCapiReleaseDir>$(MSBuildThisFileDirectory)..\..\..\target\release\</DstuCoreCapiReleaseDir>
    <DstuCoreCapiRid Condition="'$(OS)' == 'Windows_NT'">win-x64</DstuCoreCapiRid>
    <DstuCoreCapiRid Condition="'$(OS)' != 'Windows_NT' AND Exists('$(DstuCoreCapiReleaseDir)libdstu_core_capi.dylib')">osx-x64</DstuCoreCapiRid>
    <DstuCoreCapiRid Condition="'$(OS)' != 'Windows_NT' AND Exists('$(DstuCoreCapiReleaseDir)libdstu_core_capi.so')">linux-x64</DstuCoreCapiRid>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(DstuCoreCapiReleaseDir)dstu_core_capi.dll" Condition="Exists('$(DstuCoreCapiReleaseDir)dstu_core_capi.dll')"
          Pack="true" PackagePath="runtimes/$(DstuCoreCapiRid)/native/" />
    <None Include="$(DstuCoreCapiReleaseDir)libdstu_core_capi.so" Condition="Exists('$(DstuCoreCapiReleaseDir)libdstu_core_capi.so')"
          Pack="true" PackagePath="runtimes/$(DstuCoreCapiRid)/native/" />
    <None Include="$(DstuCoreCapiReleaseDir)libdstu_core_capi.dylib" Condition="Exists('$(DstuCoreCapiReleaseDir)libdstu_core_capi.dylib')"
          Pack="true" PackagePath="runtimes/$(DstuCoreCapiRid)/native/" />
  </ItemGroup>

</Project>
