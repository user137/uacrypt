{
  "name": "dstu-core",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js bindings for dstu-core (Ukrainian DSTU cryptographic standards) - provisional, not yet published to npm",
  "main": "js/index.js",
  "files": [
    "js/",
    "native/index.js",
    "native/index.d.ts",
    "native/*.node"
  ],
  "napi": {
    "name": "dstu-core",
    "triples": {
      "defaults": true
    }
  },
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">= 18"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@napi-rs/cli": "^2",
    "eslint": "^10",
    "globals": "^17"
  },
  "scripts": {
    "build": "napi build native --platform --release",
    "build:debug": "napi build native --platform",
    "test": "node --test",
    "lint": "eslint ."
  }
}
