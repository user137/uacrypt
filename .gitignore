/target
/xtask/target
/crates/dstu-core/fuzz/target
/crates/dstu-core/fuzz/corpus
/crates/dstu-core/fuzz/artifacts
**/*.rs.bk
/xtask/Cargo.lock
/crates/dstu-core/fuzz/Cargo.lock
*.pdb
.claude.local.md
/.claude/

# Oracle-harness build artifacts and fetched dependencies (Java/.NET) — fetched fresh via
# Maven/NuGet at build time (see tests/oracle-harness/*/README or docs/TASKS.md "Infrastructure"),
# never vendored or committed, same rule as /oracles below.
/tests/oracle-harness/java/lib/
/tests/oracle-harness/java/out/
/tests/oracle-harness/java/target/
/tests/oracle-harness/dotnet/bin/
/tests/oracle-harness/dotnet/obj/
# Compiled C oracle-harness drivers (gcc output built ad hoc per the build command in each .c
# file's own doc comment, never checked in) - same convention as the two rules above.
/tests/oracle-harness/*/*.exe
/tests/oracle-harness/*/*.o
# uapki-cmac-bench (T-133/D-83) links against UAPKI's prebuilt DLL, downloaded fresh per its own
# build recipe, not vendored - the DLL itself and the gendef/dlltool-generated import lib are
# local build products, same as the .exe above.
/tests/oracle-harness/uapki-cmac-bench/*.dll
/tests/oracle-harness/uapki-cmac-bench/*.def
/tests/oracle-harness/uapki-cmac-bench/*.a

# Third-party reference implementations, used only as oracles for local test-vector
# cross-verification (see oracles/README.md, docs/DECISIONS.md D-02/D-06). Never vendored into
# crates/, never committed or published — regardless of the upstream license.
# oracles/README.md itself stays tracked so the reasoning survives a fresh clone.
/oracles/*
!/oracles/README.md

# Language bindings (docs/bindings-strategy.md, D-119): each is its own separate Cargo workspace,
# so the root-scoped /target rule above doesn't reach its build output - and each has its own
# language-ecosystem build/cache artifacts on top of that. Cargo.lock IS committed per binding
# (same reproducible-build reasoning as the root Cargo.lock, which is tracked for `uacrypt`).
/bindings/*/target/
/bindings/python/__pycache__/
/bindings/python/**/__pycache__/
/bindings/python/.venv/
/bindings/python/dist/
/bindings/python/*.egg-info/
/bindings/python/.pytest_cache/
# `maturin develop`'s editable-install artifact: the compiled extension copied straight into the
# python-source tree (platform-specific binary, `*.pyd` on Windows/`*.so` on Linux/macOS).
/bindings/python/python/dstu_core/*.pyd
/bindings/python/python/dstu_core/*.so
