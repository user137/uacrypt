      "expect": "reject"
    },
    {
      "name": "argon2id m=2^31 KiB (T-272 abort)",
      "source": "hand-made",
      "password": "pw",
      "hash": "$argon2id$v=19$m=2147483648,t=1,p=1$c29tZXNhbHRzb21lc2FsdA$aGFzaGhhc2hoYXNoaGFzaGhhc2hoYXNoaGFzaGhhc2g",
      "expect": "reject"
    },
    {
      "name": "argon2id m=1048577 KiB",
      "source": "hand-made",
      "password": "pw",
      "hash": "$argon2id$v=19$m=1048577,t=1,p=1$c29tZXNhbHRzb21lc2FsdA$aGFzaGhhc2hoYXNoaGFzaGhhc2hoYXNoaGFzaGhhc2g",
      "expect": "reject"
    },
    {
      "name": "argon2id t=2^32-1",
      "source": "hand-made",
      "password": "pw",
      "hash": "$argon2id$v=19$m=8,t=4294967295,p=1$c29tZXNhbHRzb21lc2FsdA$aGFzaGhhc2hoYXNoaGFzaGhhc2hoYXNoaGFzaGhhc2g",
      "expect": "reject"
    },
    {
      "name": "argon2id m=65536 t=65 (over m*t)",
      "source": "hand-made",
      "password": "pw",
      "hash": "$argon2id$v=19$m=65536,t=65,p=1$c29tZXNhbHRzb21lc2FsdA$aGFzaGhhc2hoYXNoaGFzaGhhc2hoYXNoaGFzaGhhc2g",
      "expect": "reject"
    },
    {
      "name": "empty",
      "source": "hand-made",
      "password": "pw",
      "hash": "",
      "expect": "reject"
    },
    {
      "name": "not PHC",
      "source": "hand-made",
      "password": "pw",
      "hash": "not a PHC string",
      "expect": "reject"
    },
    {
      "name": "missing hash",
      "source": "argon2-ref, edited",
      "password": "pw",
      "hash": "$argon2id$v=19$m=8,t=1,p=1$MDEyMzQ1Njc4OWFiY2RlZg",
      "expect": "reject"
    },
    {
      "name": "duplicate m",
      "source": "argon2-ref, edited",
      "password": "pw",
      "hash": "$argon2id$v=19$m=8,m=8,t=1,p=1$MDEyMzQ1Njc4OWFiY2RlZg$LSf8dWS2rDg/5QPLiItELqsao0qJtl8C2FnmF6Ddpms",
      "expect": "reject"
    },
    {
      "name": "missing p",
      "source": "argon2-ref, edited",
      "password": "pw",
      "hash": "$argon2id$v=19$m=8,t=1$MDEyMzQ1Njc4OWFiY2RlZg$LSf8dWS2rDg/5QPLiItELqsao0qJtl8C2FnmF6Ddpms",
      "expect": "reject"
    }
  ]
}
